# vertciti chat — every configuration variable, with its default.
# Copy to your process manager / secret store. Never commit a filled-in copy.
# In CHAT_ENV=dev, missing credentials are generated per process and printed once.
# In CHAT_ENV=prod the backend refuses to start unless the REQUIRED ones are set.

CHAT_ENV=dev                         # dev | test | prod

# --- credentials (REQUIRED in prod, >= 24 chars, all different) ---
CHAT_API_KEY=                        # service key: memory, LLM route, server-side chat
CHAT_ADMIN_KEY=                      # operator key: kill switch, audit, metrics
CHAT_VISITOR_SECRET=                 # HMAC secret for anonymous visitor tokens

# --- storage and privacy ---
CHAT_DB_PATH=                        # REQUIRED in prod; default backend/data/chat.db
CHAT_RETENTION_DAYS=30               # conversations deleted after this many days
CHAT_MEMORY_BACKEND=sqlite           # only sqlite is built

# --- web ---
CHAT_CORS_ORIGINS=                   # REQUIRED in prod; dev default http://127.0.0.1:3120,http://localhost:3120

# --- anomalies runtime (HTTP only) ---
ANOMALIES_BASE_URL=http://127.0.0.1:8100
ANOMALIES_API_KEY=
CHAT_STREAM_MAX_SECONDS=120          # hard deadline for one reply
CHAT_STREAM_IDLE_SECONDS=30          # max silence between runtime events
CHAT_STREAM_MAX_CHARS=60000          # max reply size
CHAT_HISTORY_MAX_CHARS=16000         # history sent with each turn

# --- LLM router ---
CHAT_LLM_PROVIDER=openai_compat      # or "fake" (tests)
CHAT_LLM_BASE_URL=
CHAT_LLM_API_KEY=
CHAT_MODEL_DEFAULT=
CHAT_MODEL_QUALITY=
CHAT_MODEL_CHEAP=
CHAT_LLM_MAX_TOKENS=1024
CHAT_LLM_MAX_TOKENS_CAP=4096
CHAT_PRICE_TABLE=                    # JSON: {"default":{"in":100,"out":300},...} cents per 1M tokens

# --- limits ---
CHAT_RATE_PER_MINUTE=60              # per principal
CHAT_IP_RATE_PER_MINUTE=120          # per client IP, across principals
CHAT_DAILY_MESSAGE_LIMIT=200         # per service key
CHAT_VISITOR_DAILY_MESSAGE_LIMIT=50  # per visitor
CHAT_IP_DAILY_MESSAGE_LIMIT=200      # per client IP, across visitors
CHAT_VISITOR_MINT_PER_HOUR=20        # new visitor tokens per IP per hour
CHAT_VISITOR_TOKEN_TTL_HOURS=168

# --- operations (scripts/backup.py) ---
CHAT_BACKUP_DIR=backups
CHAT_BACKUP_KEEP=14
CHAT_BACKUP_OFFSITE_CMD=             # e.g. "rclone copy --immutable remote:chat-backups" (path appended)
